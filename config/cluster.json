{
	"observability": {
		"logging": {
			"serviceName": "beeline",
			"level": "info",
			"provider": "slog"
		}
	},
	"matrix": {
		"profiles": {
			"bike": 4.2,
			"car": 13.9,
			"walk": 1.4
		},
		"defaultProfile": "car",
		"server": {
			"startupDeadline": 5000000000,
			"port": 8080
		},
